            "MIMode": "lldb",
            "miDebuggerPath": "lldb-mi",
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Linux: CodeLLDB (extension)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/battery-monitor",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Windows: MSVC (cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Debug/battery-monitor.exe",
            "args": [
                "--gui"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/Debug",
            "environment": [
                {
                    "name": "QT_QPA_PLATFORM_PLUGIN_PATH",
                    "value": "${workspaceFolder}\\build\\Debug\\platforms"
                },
                {
                    "name": "BATTERY_MONITOR_DEBUG",
                    "value": "1"
                }
            ],
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
