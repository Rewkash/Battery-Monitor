{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Linux: cppdbg (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/battery-monitor",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (Debug)"
        },
        {
            "name": "Linux: cppdbg (lldb-mi)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/battery-monitor",
            "args": [],
